# Supabase Configuration
# Found at: https://supabase.com/dashboard/project/vscdkxryxsbswisebmvl/settings/api

# Public Supabase project URL (safe for client-side)
NEXT_PUBLIC_SUPABASE_URL=https://vscdkxryxsbswisebmvl.supabase.co

# Public Supabase anon key (safe for client-side)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Secret Supabase service role key (SERVER ONLY - NEVER EXPOSE TO CLIENT)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Database Configuration (for Prisma & Postgres)
# Found at: https://supabase.com/dashboard/project/vscdkxryxsbswisebmvl/settings/database
#
# Connect through Supavisor connection pooler (Transaction mode, port 6543)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct database connection for Prisma migrations (Session mode, port 5432)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"
